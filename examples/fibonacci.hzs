; fibonacci.hzs — compute fib(10) = 55 iteratively
; Demonstrates: ENTER/LEAVE, LOCAL.GET/SET, ARG.GET, JMP, CALL, RET.VAL

PUSH.I32 10
CALL @fib 1     ; call fib with 1 argument
RET.VAL

fib:
    ; arg 0 = n
    ; locals: 0=a, 1=b, 2=i
    ENTER 3
    PUSH.I32 0
    LOCAL.SET 0       ; a = 0
    PUSH.I32 1
    LOCAL.SET 1       ; b = 1
    PUSH.I32 2
    LOCAL.SET 2       ; i = 2

    ARG.GET 0
    PUSH.I32 0
    I32.LE_S
    JNZ @fib_zero     ; n <= 0 → return 0

    ARG.GET 0
    PUSH.I32 1
    I32.EQ
    JNZ @fib_one      ; n == 1 → return 1

fib_loop:
    LOCAL.GET 2       ; i
    ARG.GET 0         ; n
    I32.GT_S
    JNZ @fib_done     ; i > n → done

    LOCAL.GET 0       ; a
    LOCAL.GET 1       ; b
    I32.ADD           ; a + b

    LOCAL.GET 1       ; old b
    LOCAL.SET 0       ; a = old b
    LOCAL.SET 1       ; b = a + b (result of ADD)

    LOCAL.GET 2
    PUSH.I32 1
    I32.ADD
    LOCAL.SET 2       ; i++

    JMP @fib_loop

fib_done:
    LOCAL.GET 1       ; return b
    LEAVE
    RET.VAL

fib_zero:
    PUSH.I32 0
    LEAVE
    RET.VAL

fib_one:
    PUSH.I32 1
    LEAVE
    RET.VAL
