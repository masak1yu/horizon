{
  "name": "horizon-vm",
  "version": "0.1.0",
  "description": "Horizon VM – A browser-native virtual machine specification and reference implementation",
  "type": "module",
  "scripts": {
    "build": "tsc && node esbuild.config.mjs",
    "build:ts": "tsc",
    "bundle": "node esbuild.config.mjs",
    "build:extension": "tsc -p tsconfig.extension.json --noEmit && node extension-build.mjs",
    "test": "node --test dist/tests/vm.test.js",
    "run": "node dist/src/cli.js"
  },
  "devDependencies": {
    "@jest/globals": "^29.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.7.0"
  }
}
